.env
data/*.db
data/*.tmp
__pycache__/
.pytest_cache/

# breeze-connect writes apiLogs.log and websocketLogs.log into ./logs/ (path is fixed in the SDK)
logs/
*.log

# backtest reports (generated by python -m app.backtest)
data/backtests/

# diagnostic output (scripts/diagnostics)
data/diagnostics/

# SQLite rollback journals (left behind when a process is stopped mid-write)
*.db-journal

# download progress of the stock option history (generated by python -m app.options.stock_backtest)
data/option_download_status.json

# rows imported from aswinv90/indian-market-historical-data (personal use only, no redistribution): never committed
data/external/

# files you download by hand for the inbox importers (your own downloads; processed ones move to done/ or rejected/)
data/inbox/
