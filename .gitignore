.env
data/*.db
data/*.tmp
__pycache__/
.pytest_cache/

# breeze-connect writes apiLogs.log and websocketLogs.log into ./logs/ (path is fixed in the SDK)
logs/
*.log

# backtest reports (generated by python -m app.backtest)
data/backtests/

# diagnostic output (scripts/diagnostics)
data/diagnostics/

# SQLite rollback journals (left behind when a process is stopped mid-write)
*.db-journal
